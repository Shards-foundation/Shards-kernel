# Install as /etc/shards-kernel/github-operator.env
# Owner root, group shards-kernel, mode 0640. Never commit real values.
# Every value is injected by the operator; none is accepted from an agent.

# Operator admin bearer for /status, /policy and /evidence.
SHARDS_KERNEL_API_KEY=

# HMAC pepper used to verify independently enrolled agent credentials.
SHARDS_KERNEL_AGENT_AUTH_PEPPER=

# Public Ed25519 key that signs the operator policy. Never a private key.
SHARDS_KERNEL_POLICY_PUBLIC_KEY_HEX=

# Fine-grained GitHub token: issues:write on the single configured repository.
# Prefer a dedicated machine account and rotate on a documented schedule.
SHARDS_KERNEL_GITHUB_TOKEN=

# Shared secret injected by the authenticated reverse proxy or Tunnel.
# Must differ from every agent credential and from the GitHub token.
SHARDS_KERNEL_GATEWAY_TOKEN=
